generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EstadoLote {
  PLANIFICADO
  EN_PRODUCCION
  COSECHADO
  EMPACADO
  EXPORTADO
  CERRADO

  @@map("estado_lote")
}

enum ResultadoControl {
  APROBADO
  OBSERVADO
  RECHAZADO

  @@map("resultado_control")
}

enum EstadoEmpaque {
  DISPONIBLE
  ASIGNADO
  EN_TRANSITO
  ENTREGADO
  RECHAZADO

  @@map("estado_empaque")
}

enum EstadoEnvio {
  PLANIFICADO
  CARGADO
  EN_TRANSITO
  ENTREGADO
  CANCELADO

  @@map("estado_envio")
}

enum EstadoConfirmacionBlockchain {
  PENDIENTE
  CONFIRMADO
  ERROR

  @@map("estado_confirmacion_blockchain")
}

enum EstadoFlujo {
  PENDIENTE
  EN_PROCESO
  COMPLETADO
  RECHAZADO
  CANCELADO

  @@map("estado_flujo")
}

enum TipoUnidadTrazable {
  LOTE
  EMPAQUE
  ENVIO

  @@map("tipo_unidad_trazable")
}

enum RolUnidadFlujo {
  PRINCIPAL
  ENTRADA
  SALIDA

  @@map("rol_unidad_flujo")
}

model Rol {
  idRol       Int       @id @default(autoincrement()) @map("id_rol") @db.SmallInt
  nombre      String    @unique @db.VarChar(40)
  descripcion String?   @db.VarChar(150)
  usuarios    Usuario[]
  menus       RolMenu[]
  fases       Fase[]

  @@map("roles")
}

model Pantalla {
  idPantalla  Int     @id @default(autoincrement()) @map("id_pantalla") @db.SmallInt
  nombre      String  @db.VarChar(60)
  ruta        String  @unique @db.VarChar(120)
  icono       String? @db.VarChar(50)
  descripcion String? @db.VarChar(200)
  estado      Boolean @default(true)

  menus Menu[]

  @@map("pantallas")
}

model Menu {
  idMenu      Int     @id @default(autoincrement()) @map("id_menu") @db.SmallInt
  idPantalla  Int?    @map("id_pantalla") @db.SmallInt
  idMenuPadre Int?    @map("id_menu_padre") @db.SmallInt
  etiqueta    String  @db.VarChar(60)
  icono       String? @db.VarChar(50)
  orden       Int     @default(0) @db.SmallInt
  estado      Boolean @default(true)

  pantalla Pantalla? @relation(fields: [idPantalla], references: [idPantalla], onDelete: SetNull, onUpdate: Cascade)
  padre    Menu?     @relation("MenuJerarquia", fields: [idMenuPadre], references: [idMenu], onDelete: SetNull, onUpdate: Cascade)
  hijos    Menu[]    @relation("MenuJerarquia")
  roles    RolMenu[]

  @@index([idPantalla])
  @@index([idMenuPadre])
  @@map("menus")
}

model RolMenu {
  idRol  Int @map("id_rol") @db.SmallInt
  idMenu Int @map("id_menu") @db.SmallInt

  rol  Rol  @relation(fields: [idRol], references: [idRol], onDelete: Cascade, onUpdate: Cascade)
  menu Menu @relation(fields: [idMenu], references: [idMenu], onDelete: Cascade, onUpdate: Cascade)

  @@id([idRol, idMenu])
  @@map("rol_menu")
}

model Usuario {
  idUsuario          BigInt    @id @default(autoincrement()) @map("id_usuario")
  idRol              Int       @map("id_rol") @db.SmallInt
  idProductor        BigInt?   @map("id_productor")
  nombres            String    @db.VarChar(80)
  apellidos          String    @db.VarChar(80)
  correo             String    @unique @db.VarChar(120)
  claveHash          String    @map("clave_hash") @db.VarChar(255)
  estado             Boolean   @default(true)
  fechaCreacion      DateTime  @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaActualizacion DateTime? @updatedAt @map("fecha_actualizacion") @db.Timestamptz(6)

  rol               Rol                   @relation(fields: [idRol], references: [idRol], onDelete: Restrict, onUpdate: Cascade)
  productor         Productor?            @relation(fields: [idProductor], references: [idProductor], onDelete: SetNull, onUpdate: Cascade)
  eventos           EventoTrazabilidad[]
  controlesCalidad  ControlCalidad[]
  fasesAsignadas    FaseEjecucion[]
  transicionesFlujo TransicionEjecucion[]

  @@index([idRol])
  @@index([idProductor])
  @@map("usuarios")
}

model Flujo {
  idFlujo       Int      @id @default(autoincrement()) @map("id_flujo") @db.SmallInt
  codigo        String   @db.VarChar(50)
  version       Int      @default(1) @db.SmallInt
  nombre        String   @db.VarChar(100)
  descripcion   String?  @db.Text
  activo        Boolean  @default(true)
  fechaCreacion DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz(6)

  fases      Fase[]
  instancias FlujoInstancia[]

  @@unique([codigo, version])
  @@index([activo])
  @@map("flujos")
}

model Fase {
  idFase             Int         @id @default(autoincrement()) @map("id_fase") @db.SmallInt
  idFlujo            Int         @map("id_flujo") @db.SmallInt
  idRolResponsable   Int?        @map("id_rol_responsable") @db.SmallInt
  codigo             String      @db.VarChar(50)
  nombre             String      @db.VarChar(100)
  orden              Int         @db.SmallInt
  requiereAprobacion Boolean     @default(false) @map("requiere_aprobacion")
  estadoLoteInicio   EstadoLote? @map("estado_lote_inicio")
  estadoLoteFin      EstadoLote? @map("estado_lote_fin")
  activo             Boolean     @default(true)

  flujo               Flujo            @relation(fields: [idFlujo], references: [idFlujo], onDelete: Restrict, onUpdate: Cascade)
  rolResponsable      Rol?             @relation(fields: [idRolResponsable], references: [idRol], onDelete: Restrict, onUpdate: Cascade)
  ejecuciones         FaseEjecucion[]
  transicionesOrigen  TransicionFase[] @relation("FaseOrigen")
  transicionesDestino TransicionFase[] @relation("FaseDestino")

  @@unique([idFlujo, codigo])
  @@unique([idFlujo, orden])
  @@unique([idFase, idFlujo])
  @@index([idRolResponsable])
  @@map("fases")
}

model TransicionFase {
  idTransicionFase Int     @id @default(autoincrement()) @map("id_transicion_fase") @db.SmallInt
  idFaseOrigen     Int     @map("id_fase_origen") @db.SmallInt
  idFaseDestino    Int     @map("id_fase_destino") @db.SmallInt
  activo           Boolean @default(true)

  faseOrigen  Fase @relation("FaseOrigen", fields: [idFaseOrigen], references: [idFase], onDelete: Restrict, onUpdate: Cascade)
  faseDestino Fase @relation("FaseDestino", fields: [idFaseDestino], references: [idFase], onDelete: Restrict, onUpdate: Cascade)

  @@unique([idFaseOrigen, idFaseDestino])
  @@index([idFaseDestino])
  @@map("transiciones_fase")
}

model UnidadTrazable {
  idUnidad      BigInt             @id @default(autoincrement()) @map("id_unidad")
  tipo          TipoUnidadTrazable
  codigo        String             @default("") @db.VarChar(255)
  fechaRegistro DateTime           @default(now()) @map("fecha_registro") @db.Timestamptz(6)

  lote       LoteProduccion?
  empaque    Empaque?
  envio      Envio?
  instancias FlujoInstanciaUnidad[]
  eventos    EventoTrazabilidad[]

  @@unique([tipo, codigo])
  @@index([tipo])
  @@map("unidades_trazables")
}

model FlujoInstancia {
  idInstancia   BigInt      @id @default(autoincrement()) @map("id_instancia")
  idFlujo       Int         @map("id_flujo") @db.SmallInt
  codigo        String      @unique @default("") @db.VarChar(100)
  estado        EstadoFlujo @default(PENDIENTE)
  fechaInicio   DateTime?   @map("fecha_inicio") @db.Timestamptz(6)
  fechaFin      DateTime?   @map("fecha_fin") @db.Timestamptz(6)
  fechaRegistro DateTime    @default(now()) @map("fecha_registro") @db.Timestamptz(6)

  flujo               Flujo                  @relation(fields: [idFlujo], references: [idFlujo], onDelete: Restrict, onUpdate: Cascade)
  unidades            FlujoInstanciaUnidad[]
  ejecuciones         FaseEjecucion[]
  registrosBlockchain RegistroBlockchain[]

  @@unique([idInstancia, idFlujo])
  @@index([idFlujo, estado])
  @@map("flujo_instancias")
}

model FlujoInstanciaUnidad {
  idInstancia BigInt         @map("id_instancia")
  idUnidad    BigInt         @map("id_unidad")
  rol         RolUnidadFlujo @default(PRINCIPAL)

  instancia FlujoInstancia @relation(fields: [idInstancia], references: [idInstancia], onDelete: Cascade, onUpdate: Cascade)
  unidad    UnidadTrazable @relation(fields: [idUnidad], references: [idUnidad], onDelete: Restrict, onUpdate: Cascade)

  @@id([idInstancia, idUnidad])
  @@index([idUnidad, rol])
  @@map("flujo_instancia_unidad")
}

model FaseEjecucion {
  idEjecucion      BigInt      @id @default(autoincrement()) @map("id_ejecucion")
  idInstancia      BigInt      @map("id_instancia")
  idFase           Int         @map("id_fase") @db.SmallInt
  idFlujo          Int         @map("id_flujo") @db.SmallInt
  idResponsable    BigInt?     @map("id_responsable")
  numeroIntento    Int         @default(1) @map("numero_intento") @db.SmallInt
  estado           EstadoFlujo @default(PENDIENTE)
  datosAdicionales Json        @default("{}") @map("datos_adicionales") @db.JsonB
  fechaInicio      DateTime?   @map("fecha_inicio") @db.Timestamptz(6)
  fechaFin         DateTime?   @map("fecha_fin") @db.Timestamptz(6)
  fechaRegistro    DateTime    @default(now()) @map("fecha_registro") @db.Timestamptz(6)

  instancia        FlujoInstancia        @relation(fields: [idInstancia, idFlujo], references: [idInstancia, idFlujo], onDelete: Cascade, onUpdate: Cascade)
  fase             Fase                  @relation(fields: [idFase, idFlujo], references: [idFase, idFlujo], onDelete: Restrict, onUpdate: Cascade)
  responsable      Usuario?              @relation(fields: [idResponsable], references: [idUsuario], onDelete: Restrict, onUpdate: Cascade)
  transiciones     TransicionEjecucion[]
  eventos          EventoTrazabilidad[]
  controlesCalidad ControlCalidad[]
  empaques         Empaque[]
  envios           Envio[]

  @@unique([idInstancia, idFase, numeroIntento])
  @@index([idInstancia, estado])
  @@index([idFase])
  @@index([idResponsable])
  @@map("fase_ejecuciones")
}

model TransicionEjecucion {
  idTransicion     BigInt       @id @default(autoincrement()) @map("id_transicion")
  idEjecucion      BigInt       @map("id_ejecucion")
  idUsuario        BigInt       @map("id_usuario")
  estadoAnterior   EstadoFlujo? @map("estado_anterior")
  estadoNuevo      EstadoFlujo  @map("estado_nuevo")
  comentario       String?      @db.Text
  datosAdicionales Json         @default("{}") @map("datos_adicionales") @db.JsonB
  fechaTransicion  DateTime     @default(now()) @map("fecha_transicion") @db.Timestamptz(6)

  ejecucion          FaseEjecucion       @relation(fields: [idEjecucion], references: [idEjecucion], onDelete: Restrict, onUpdate: Cascade)
  usuario            Usuario             @relation(fields: [idUsuario], references: [idUsuario], onDelete: Restrict, onUpdate: Cascade)
  registroBlockchain RegistroBlockchain?

  @@index([idEjecucion, fechaTransicion])
  @@index([idUsuario])
  @@map("transiciones_ejecucion")
}

model Productor {
  idProductor        BigInt    @id @default(autoincrement()) @map("id_productor")
  identificacion     String    @unique @db.VarChar(20)
  nombreRazonSocial  String    @map("nombre_razon_social") @db.VarChar(150)
  telefono           String?   @db.VarChar(20)
  correo             String?   @db.VarChar(120)
  direccion          String?   @db.Text
  fechaActualizacion DateTime? @updatedAt @map("fecha_actualizacion") @db.Timestamptz(6)

  fincas   Finca[]
  usuarios Usuario[]

  @@map("productores")
}

model Finca {
  idFinca            BigInt    @id @default(autoincrement()) @map("id_finca")
  idProductor        BigInt    @map("id_productor")
  codigoFinca        String    @unique @default(dbgenerated()) @map("codigo_finca") @db.VarChar(30)
  nombre             String    @db.VarChar(100)
  pais               String    @db.VarChar(80)
  region             String    @db.VarChar(100)
  localidad          String    @db.VarChar(100)
  sublocalidad       String?   @db.VarChar(100)
  latitud            Decimal?  @db.Decimal(9, 6)
  longitud           Decimal?  @db.Decimal(9, 6)
  areaHectareas      Decimal?  @map("area_hectareas") @db.Decimal(10, 2)
  estado             Boolean   @default(true)
  fechaActualizacion DateTime? @updatedAt @map("fecha_actualizacion") @db.Timestamptz(6)

  productor       Productor        @relation(fields: [idProductor], references: [idProductor], onDelete: Restrict, onUpdate: Cascade)
  lotes           LoteProduccion[]
  certificaciones Certificacion[]

  @@index([idProductor])
  @@map("fincas")
}

model Variedad {
  idVariedad  Int              @id @default(autoincrement()) @map("id_variedad") @db.SmallInt
  codigo      String           @unique @db.VarChar(30)
  nombre      String           @db.VarChar(60)
  descripcion String?          @db.VarChar(255)
  activo      Boolean          @default(true)
  lotes       LoteProduccion[]

  @@map("variedades")
}

model LoteProduccion {
  idLote               BigInt     @id @default(autoincrement()) @map("id_lote")
  idUnidad             BigInt     @unique @map("id_unidad")
  idFinca              BigInt     @map("id_finca")
  codigoLote           String     @unique @default(dbgenerated()) @map("codigo_lote") @db.VarChar(40)
  idVariedad           Int?       @map("id_variedad") @db.SmallInt
  fechaSiembra         DateTime?  @map("fecha_siembra") @db.Date
  fechaEstimadaCosecha DateTime?  @map("fecha_estimada_cosecha") @db.Date
  fechaCosecha         DateTime?  @map("fecha_cosecha") @db.Date
  cantidadPlantas      Int?       @map("cantidad_plantas")
  pesoCosechadoKg      Decimal?   @map("peso_cosechado_kg") @db.Decimal(12, 2)
  estado               EstadoLote @default(PLANIFICADO)
  fechaRegistro        DateTime   @default(now()) @map("fecha_registro") @db.Timestamptz(6)
  fechaActualizacion   DateTime?  @updatedAt @map("fecha_actualizacion") @db.Timestamptz(6)

  unidad           UnidadTrazable   @relation(fields: [idUnidad], references: [idUnidad], onDelete: Restrict, onUpdate: Cascade)
  finca            Finca            @relation(fields: [idFinca], references: [idFinca], onDelete: Restrict, onUpdate: Cascade)
  variedadCat      Variedad?        @relation(fields: [idVariedad], references: [idVariedad], onDelete: SetNull, onUpdate: Cascade)
  controlesCalidad ControlCalidad[]
  empaques         Empaque[]

  @@index([idFinca])
  @@index([idVariedad])
  @@index([estado])
  @@map("lotes_produccion")
}

model TipoEvento {
  idTipoEvento Int     @id @default(autoincrement()) @map("id_tipo_evento") @db.SmallInt
  nombre       String  @unique @db.VarChar(50)
  descripcion  String? @db.VarChar(200)

  eventos EventoTrazabilidad[]

  @@map("tipos_evento")
}

model EventoTrazabilidad {
  idEvento         BigInt   @id @default(autoincrement()) @map("id_evento")
  idUnidad         BigInt   @map("id_unidad")
  idEjecucion      BigInt   @map("id_ejecucion")
  idTipoEvento     Int      @map("id_tipo_evento") @db.SmallInt
  idUsuario        BigInt   @map("id_usuario")
  fechaEvento      DateTime @map("fecha_evento") @db.Timestamptz(6)
  ubicacion        String?  @db.VarChar(150)
  descripcion      String?  @db.Text
  datosAdicionales Json     @default("{}") @map("datos_adicionales") @db.JsonB
  fechaRegistro    DateTime @default(now()) @map("fecha_registro") @db.Timestamptz(6)

  unidad     UnidadTrazable        @relation(fields: [idUnidad], references: [idUnidad], onDelete: Restrict, onUpdate: Cascade)
  ejecucion  FaseEjecucion         @relation(fields: [idEjecucion], references: [idEjecucion], onDelete: Restrict, onUpdate: Cascade)
  tipoEvento TipoEvento            @relation(fields: [idTipoEvento], references: [idTipoEvento], onDelete: Restrict, onUpdate: Cascade)
  usuario    Usuario               @relation(fields: [idUsuario], references: [idUsuario], onDelete: Restrict, onUpdate: Cascade)
  documentos DocumentoReferencia[]

  @@index([idUnidad, fechaEvento])
  @@index([idEjecucion])
  @@index([idTipoEvento])
  @@index([idUsuario])
  @@map("eventos_trazabilidad")
}

model ControlCalidad {
  idControl           BigInt           @id @default(autoincrement()) @map("id_control")
  idEjecucion         BigInt           @map("id_ejecucion")
  idLote              BigInt           @map("id_lote")
  idUsuario           BigInt           @map("id_usuario")
  idCategoriaCalidad  Int?             @map("id_categoria_calidad")
  fechaControl        DateTime         @default(now()) @map("fecha_control") @db.Timestamptz(6)
  calibreMm           Decimal?         @map("calibre_mm") @db.Decimal(6, 2)
  pesoMuestraKg       Decimal?         @map("peso_muestra_kg") @db.Decimal(8, 2)
  porcentajeRechazo   Decimal?         @map("porcentaje_rechazo") @db.Decimal(5, 2)
  resultado           ResultadoControl
  observaciones       String?          @db.Text

  ejecucion           FaseEjecucion    @relation(fields: [idEjecucion], references: [idEjecucion], onDelete: Restrict, onUpdate: Cascade)
  lote                LoteProduccion   @relation(fields: [idLote], references: [idLote], onDelete: Restrict, onUpdate: Cascade)
  usuario             Usuario          @relation(fields: [idUsuario], references: [idUsuario], onDelete: Restrict, onUpdate: Cascade)
  categoriaCalidadCat CategoriaCalidad? @relation(fields: [idCategoriaCalidad], references: [idCategoriaCalidad], onDelete: SetNull, onUpdate: Cascade)

  @@index([idEjecucion])
  @@index([idLote, fechaControl])
  @@index([idUsuario])
  @@index([idCategoriaCalidad])
  @@map("controles_calidad")
}

model Certificacion {
  idCertificacion        BigInt    @id @default(autoincrement()) @map("id_certificacion")
  idFinca                BigInt    @map("id_finca")
  idTipoCertificacion    Int       @map("id_tipo_certificacion")
  idEntidadCertificadora Int       @map("id_entidad_certificadora")
  numeroCertificado      String    @unique @map("numero_certificado") @db.VarChar(80)
  fechaEmision           DateTime  @map("fecha_emision") @db.Date
  fechaVencimiento       DateTime? @map("fecha_vencimiento") @db.Date
  documentoUrl           String?   @map("documento_url") @db.VarChar(500)

  finca                Finca                @relation(fields: [idFinca], references: [idFinca], onDelete: Restrict, onUpdate: Cascade)
  tipoCertificacion    TipoCertificacion    @relation(fields: [idTipoCertificacion], references: [idTipoCertificacion], onDelete: Restrict, onUpdate: Cascade)
  entidadCertificadora EntidadCertificadora @relation(fields: [idEntidadCertificadora], references: [idEntidadCertificadora], onDelete: Restrict, onUpdate: Cascade)

  @@index([idFinca])
  @@index([idTipoCertificacion])
  @@index([idEntidadCertificadora])
  @@map("certificaciones")
}

model Empaque {
  idEmpaque           BigInt        @id @default(autoincrement()) @map("id_empaque")
  idUnidad            BigInt        @unique @map("id_unidad")
  idEjecucion         BigInt        @map("id_ejecucion")
  idLote              BigInt        @map("id_lote")
  idCategoriaCalidad  Int?          @map("id_categoria_calidad")
  codigoCaja          String        @unique @default("") @map("codigo_caja") @db.VarChar(50)
  fechaEmpaque        DateTime      @default(now()) @map("fecha_empaque") @db.Timestamptz(6)
  pesoNetoKg          Decimal       @map("peso_neto_kg") @db.Decimal(8, 2)
  codigoQr            String?       @unique @map("codigo_qr") @db.VarChar(255)
  estado              EstadoEmpaque @default(DISPONIBLE)

  unidad              UnidadTrazable  @relation(fields: [idUnidad], references: [idUnidad], onDelete: Restrict, onUpdate: Cascade)
  ejecucion           FaseEjecucion   @relation(fields: [idEjecucion], references: [idEjecucion], onDelete: Restrict, onUpdate: Cascade)
  lote                LoteProduccion  @relation(fields: [idLote], references: [idLote], onDelete: Restrict, onUpdate: Cascade)
  categoriaCalidadCat CategoriaCalidad? @relation(fields: [idCategoriaCalidad], references: [idCategoriaCalidad], onDelete: SetNull, onUpdate: Cascade)
  enviosEmpaque       EnvioEmpaque[]

  @@index([idEjecucion])
  @@index([idLote])
  @@index([estado])
  @@index([idCategoriaCalidad])
  @@map("empaques")
}

model Envio {
  idEnvio              BigInt      @id @default(autoincrement()) @map("id_envio")
  idUnidad             BigInt      @unique @map("id_unidad")
  idEjecucion          BigInt      @map("id_ejecucion")
  idNaviera            Int?        @map("id_naviera")
  idPuertoOrigen       Int         @map("id_puerto_origen")
  idPuertoDestino      Int         @map("id_puerto_destino")
  codigoEnvio          String      @unique @default("") @map("codigo_envio") @db.VarChar(40)
  numeroContenedor     String?     @map("numero_contenedor") @db.VarChar(30)
  fechaSalida          DateTime?   @map("fecha_salida") @db.Timestamptz(6)
  fechaEstimadaLlegada DateTime?   @map("fecha_estimada_llegada") @db.Timestamptz(6)
  temperaturaSalida    Decimal?    @map("temperatura_salida") @db.Decimal(5, 2)
  estado               EstadoEnvio @default(PLANIFICADO)

  unidad         UnidadTrazable @relation(fields: [idUnidad], references: [idUnidad], onDelete: Restrict, onUpdate: Cascade)
  ejecucion      FaseEjecucion  @relation(fields: [idEjecucion], references: [idEjecucion], onDelete: Restrict, onUpdate: Cascade)
  naviera        Naviera?       @relation(fields: [idNaviera], references: [idNaviera], onDelete: SetNull, onUpdate: Cascade)
  puertoOrigen   Puerto         @relation("puertoOrigen", fields: [idPuertoOrigen], references: [idPuerto], onDelete: Restrict, onUpdate: Cascade)
  puertoDestino  Puerto         @relation("puertoDestino", fields: [idPuertoDestino], references: [idPuerto], onDelete: Restrict, onUpdate: Cascade)
  empaques       EnvioEmpaque[]

  @@index([idEjecucion])
  @@index([estado, fechaSalida])
  @@index([idNaviera])
  @@index([idPuertoOrigen])
  @@index([idPuertoDestino])
  @@map("envios")
}

model EnvioEmpaque {
  idEnvio   BigInt @map("id_envio")
  idEmpaque BigInt @map("id_empaque")

  envio   Envio   @relation(fields: [idEnvio], references: [idEnvio], onDelete: Cascade, onUpdate: Cascade)
  empaque Empaque @relation(fields: [idEmpaque], references: [idEmpaque], onDelete: Cascade, onUpdate: Cascade)

  @@id([idEnvio, idEmpaque])
  @@index([idEmpaque])
  @@map("envio_empaque")
}

model RegistroBlockchain {
  idRegistroBlockchain     BigInt                       @id @default(autoincrement()) @map("id_registro_blockchain")
  idInstancia              BigInt                       @map("id_instancia")
  idTransicion             BigInt                       @unique @map("id_transicion")
  indice                   Int                          @map("indice")
  hashDatos                String                       @unique @map("hash_datos") @db.Char(64)
  hashAnterior             String?                      @map("hash_anterior") @db.Char(64)
  payloadCanonico          String                       @map("payload_canonico") @db.Text
  algoritmo                String                       @default("SHA-256") @db.VarChar(20)
  identificadorTransaccion String?                      @map("identificador_transaccion") @db.VarChar(150)
  redBlockchain            String?                      @map("red_blockchain") @db.VarChar(60)
  fechaRegistro            DateTime                     @default(now()) @map("fecha_registro") @db.Timestamptz(6)
  estadoConfirmacion       EstadoConfirmacionBlockchain @default(PENDIENTE) @map("estado_confirmacion")

  instancia  FlujoInstancia      @relation(fields: [idInstancia], references: [idInstancia], onDelete: Restrict, onUpdate: Cascade)
  transicion TransicionEjecucion @relation(fields: [idTransicion], references: [idTransicion], onDelete: Restrict, onUpdate: Cascade)

  @@unique([idInstancia, indice])
  @@map("registros_blockchain")
}

model DocumentoReferencia {
  idDocumento      BigInt   @id @default(autoincrement()) @map("id_documento")
  idEvento         BigInt   @map("id_evento")
  idTipoDocumento  Int      @map("id_tipo_documento")
  nombre           String   @db.VarChar(120)
  url              String   @db.VarChar(500)
  fechaCarga       DateTime @default(now()) @map("fecha_carga") @db.Timestamptz(6)

  evento         EventoTrazabilidad @relation(fields: [idEvento], references: [idEvento], onDelete: Restrict, onUpdate: Cascade)
  tipoDocumento  TipoDocumento      @relation(fields: [idTipoDocumento], references: [idTipoDocumento], onDelete: Restrict, onUpdate: Cascade)

  @@index([idEvento])
  @@index([idTipoDocumento])
  @@map("documentos_referencia")
}

model TipoDocumento {
  idTipoDocumento Int     @id @default(autoincrement()) @map("id_tipo_documento")
  codigo          String  @unique @db.VarChar(40)
  nombre          String  @db.VarChar(100)
  descripcion     String? @db.VarChar(255)
  activo          Boolean @default(true)

  documentos DocumentoReferencia[]

  @@map("tipos_documento")
}

model CategoriaCalidad {
  idCategoriaCalidad Int     @id @default(autoincrement()) @map("id_categoria_calidad")
  codigo             String  @unique @db.VarChar(40)
  nombre             String  @db.VarChar(100)
  descripcion        String? @db.VarChar(255)
  activo             Boolean @default(true)

  controles ControlCalidad[]
  empaques  Empaque[]

  @@map("categorias_calidad")
}

model Naviera {
  idNaviera Int     @id @default(autoincrement()) @map("id_naviera")
  codigo    String  @unique @db.VarChar(40)
  nombre    String  @db.VarChar(100)
  activo    Boolean @default(true)

  envios Envio[]

  @@map("navieras")
}

model Puerto {
  idPuerto   Int     @id @default(autoincrement()) @map("id_puerto")
  codigo     String  @unique @db.VarChar(10)
  nombre     String  @db.VarChar(100)
  paisCodigo String  @map("pais_codigo") @db.VarChar(5)
  paisNombre String  @map("pais_nombre") @db.VarChar(80)
  activo     Boolean @default(true)

  enviosOrigen  Envio[] @relation("puertoOrigen")
  enviosDestino Envio[] @relation("puertoDestino")

  @@map("puertos")
}

model TipoCertificacion {
  idTipoCertificacion Int     @id @default(autoincrement()) @map("id_tipo_certificacion")
  codigo              String  @unique @db.VarChar(40)
  nombre              String  @db.VarChar(100)
  activo              Boolean @default(true)

  certificaciones Certificacion[]

  @@map("tipos_certificacion")
}

model EntidadCertificadora {
  idEntidadCertificadora Int     @id @default(autoincrement()) @map("id_entidad_certificadora")
  codigo                 String  @unique @db.VarChar(40)
  nombre                 String  @db.VarChar(100)
  alcance                String? @db.VarChar(100)
  activo                 Boolean @default(true)

  certificaciones Certificacion[]

  @@map("entidades_certificadoras")
}
