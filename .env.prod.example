# Configuración de Base de Datos
POSTGRES_USER=prod_admin
POSTGRES_PASSWORD=super_secure_password_here
POSTGRES_DB=coil_prod_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?schema=public

# Configuración del Backend
PORT=3000
JWT_SECRET=super_secure_jwt_secret_for_production
JWT_ACCESS_EXPIRES_IN=15m
# Debe ser un secreto distinto de JWT_SECRET (los refresh tokens no deben poder verificarse con la clave del access token)
JWT_REFRESH_SECRET=super_secure_jwt_refresh_secret_for_production
JWT_REFRESH_EXPIRES_IN=7d
NODE_ENV=production

# URL pública del frontend, usada para construir los enlaces de los códigos QR
FRONTEND_URL=https://coil.labtorres.me

